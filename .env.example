# ═══════════════════════════════════════════════════════════════════════════
# Chiron 本地模式 — 环境配置
# ═══════════════════════════════════════════════════════════════════════════
# 复制为 .env 后按需修改：cp .env.example .env
#
# 本地模式（Electron 桌面壳）会**自动注入**大部分基础设施配置：
#   POSTGRES_DSN / REDIS_ADDR / PORT / APP_SECRET / DEGRADED_MODE /
#   STORAGE_ROOT / PLUGIN_DATA_DIR / PYTHON_ENGINE_ADDRESS
# 由 desktop-local 引导器拉起 embedded PostgreSQL 与 Redis 后交给网关，
# 因此本文件通常**只需关心 APP_SECRET**。其余为裸机 / 开发调试时的可选覆盖。
#
# 业务与基础设施的其余配置（模型、存储、限流等）由后台「系统设置」维护，
# 经 system_settings 表持久化，敏感值用 APP_SECRET 派生密钥做 AES-256-GCM
# 加密后落库，无需写在这里。
# ═══════════════════════════════════════════════════════════════════════════

# ── APP_SECRET（必须）────────────────────────────────────────────────────
# 部署级主密钥：≥32 字符，随机唯一。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 用途：派生 JWT_SECRET / INTERNAL_TOKEN，并加密 system_settings 中的敏感配置。
# 警告：丢失 APP_SECRET 将导致无法解密已加密的配置。
APP_SECRET=change-me-to-32-plus-random-chars
CHIRON_DATA_DIR=~/.chiron

# ── 本地基础设施（可选覆盖）──────────────────────────────────────────────
# 本地模式由引导器自动生成并注入，通常无需设置；仅裸机直连外部服务时才填。
#POSTGRES_DSN=postgresql://user:pass@127.0.0.1:5432/chiron
#REDIS_ADDR=127.0.0.1:6379

# 单机开发的降级开关。默认 false = Redis 缺失时拒绝启动。
# 本地模式 Electron 会设为 true（Redis 不可用时的放行路径）。
#DEGRADED_MODE=true

# 沙箱执行：service(下沉独立容器) / local(进程内)。本地单机用 local。
# 未配 SANDBOX_SERVICE_URL 且 DEGRADED_MODE=false 时引擎会拒绝启动。
#SANDBOX_BACKEND=local

# 媒体对象存储：本地模式固定 local(写入磁盘)。生产用 s3。
#STORAGE_BACKEND=local
# 引擎的媒体后端，必须与 STORAGE_BACKEND 同值。
#MEDIA_STORE_BACKEND=local

# ── Agent 预算 ───────────────────────────────────────────────────────────
# ① 网关侧（单次调用 / 默认回合数；后台「系统设置」优先，env 只是部署默认）
#AGENT_MAX_OUTPUT_TOKENS=8192   # 单次 LLM 调用的 max output tokens
#AGENT_DEFAULT_MAX_TURNS=5      # 每次提交的默认回合数

# ② 引擎侧（一个 run 全程；0 = 该轴不限）
#AGENT_RUN_MAX_TOKENS=400000    # 单 run token 上限
#AGENT_RUN_MAX_TURNS=0
#AGENT_MAX_STEPS=60             # 单 run 工具调用次数上限
#AGENT_MAX_SECONDS=0
#AGENT_MAX_COST=0
# 子 Agent 的 per-run 预算
#SUBAGENT_RUN_MAX_TOKENS=200000
#SUBAGENT_RUN_MAX_TURNS=0
#SUBAGENT_MAX_STEPS=0
#SUBAGENT_MAX_SECONDS=0
#SUBAGENT_MAX_COST=0

# 任务线闸门（同一 root run 派生的全部委派与续跑的第二道闸门）。
# 默认 shadow：只算不算、不阻断；enforce 才真的暂停超限任务线。
#SUBAGENT_LINE_PROJECTION=shadow
# M26 会话线闸门：off / shadow / enforce（enforce 时主 run 会被真的拦下）
#SESSION_LINE_GATE=shadow

# 换 key 重试：一次 LLM 请求遇到坏 key / 限流时换一把 key 再试（用户无感）。
# 只覆盖"还没向调用方产出任何东西"的那次调用；流式响应一旦开始绝不重试。
#KEY_RETRY_MAX=1

# ── 知识库（PageIndex）───────────────────────────────────────────────────
# 两种 provider 二选一，在「知识库设置」页选择：
#   自托管：用下面配置的模型 + 索引目录自己建索引（仅 text-based PDF）
#   Cloud ：用户自带 PageIndex API key（支持 PDF/PPTX/Word 与扫描件 OCR）
# 自托管索引根目录（单机默认即可）。
#KNOWLEDGE_SELFHOSTED_ROOT=
# 自托管使用的模型（端点与 key 复用 provider 配置 / 后台「服务提供商」）
#KNOWLEDGE_SELFHOSTED_INDEX_MODEL=
#KNOWLEDGE_SELFHOSTED_CHAT_MODEL=
# Cloud 模式的问答模型（索引与存储在 PageIndex Cloud）
#KNOWLEDGE_CLOUD_CHAT_MODEL=
# 原文对象存储（默认跟随 MEDIA_STORE_BACKEND）
#KNOWLEDGE_BLOB_BACKEND=
#KNOWLEDGE_LOCAL_PATH=
# 知识库服务（PageIndex 跑在独立进程/镜像里，引擎经内网 HTTP 调它）。
# 未配时知识库显示"未启用"，不阻塞启动。
#KNOWLEDGE_SERVICE_URL=
#KNOWLEDGE_SERVICE_TIMEOUT=120
#PAGEINDEX_WORKER_CONCURRENCY=2
#PAGEINDEX_MAX_CONCURRENCY=4

# ── 模型密钥 ─────────────────────────────────────────────────────────────
# 亦可在后台「系统设置」维护后下发。
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#LLM_API_KEY=
